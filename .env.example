# Copy this to .env for local development. Never commit the real .env file.
#
# For Render deployment, these same six OAuth vars + BASE_URL are set in
# the Render dashboard's Environment tab instead (see render.yaml) — this
# file is for local dev only.

# Leave unset locally to default to http://localhost:8000 (see main.py).
# On Render, set this to the assigned service URL once known.
BASE_URL=http://localhost:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
